# Application
APP_NAME=Voltaris AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
TOTP_ENCRYPTION_KEY=change-me-to-a-32-byte-base64-or-hex-key

# Database (SQLite for local; PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./voltaris.db

# CORS / Frontend
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model
MODEL_PATH=ml_artifacts/phaseguard_model.pkl
MODEL_VERSION=phaseguard-rf-1.0

# Email (development: console; production: SMTP or provider)
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@voltaris.local

# Rate limiting
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_PREDICT=30/minute

# Session
SESSION_COOKIE_NAME=voltaris_session
SESSION_MAX_AGE_SECONDS=86400
PRE_AUTH_MAX_AGE_SECONDS=300
